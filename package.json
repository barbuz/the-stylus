{
  "name": "the-stylus",
  "version": "1.0.0",
  "description": "A browser-based tool for gurus to edit result sheets for 3 Card Blind MTG matches from 3cardblind.com",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "echo 'Open index.html in your browser'",
    "build": "echo 'No build required - static HTML/CSS/JS'",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "keywords": [
    "3cardblind",
    "mtg",
    "magic-the-gathering",
    "tournament",
    "result-sheets",
    "guru-tools",
    "browser-app",
    "static-hosting"
  ],
  "author": "Leo Ghignone",
  "license": "MIT"
}
